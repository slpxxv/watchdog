{% extends 'base.html.twig' %}

{% set shell = shell() %}
{% set projectId = shell.projectId %}
{% set route = app.current_route %}

{% macro icon(name) %}
    {% if name == 'live' %}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12h4l3-8 4 16 3-8h4"/></svg>
    {% elseif name == 'events' %}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h10"/></svg>
    {% elseif name == 'sources' %}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3c4.4 0 8 1.3 8 3s-3.6 3-8 3-8-1.3-8-3 3.6-3 8-3zM4 6v12c0 1.7 3.6 3 8 3s8-1.3 8-3V6M4 12c0 1.7 3.6 3 8 3s8-1.3 8-3"/></svg>
    {% elseif name == 'projects' %}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg>
    {% elseif name == 'debug' %}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 9h8M8 13h8M8 17h5M6 3h12a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z"/></svg>
    {% endif %}
{% endmacro %}

{% block body %}
{% import _self as ui %}
{% set section = route == 'log_events' ? 'events' : (route starts with 'source_' ? 'sources' : 'live') %}
<div class="shell">
    <aside class="sidebar glass">
        <a href="{{ path('home') }}" class="brand"><span class="brand-mark" aria-hidden="true"></span>Watchdog</a>

        {% if shell.projects %}
            <form class="project-switch" action="{{ path('project_switch') }}" method="get" data-controller="autosubmit">
                <label for="project-switch" class="visually-hidden">Projekt</label>
                <input type="hidden" name="section" value="{{ section }}">
                <select id="project-switch" name="project" data-action="change->autosubmit#submit">
                    {% if not projectId %}<option value="" selected disabled>Wybierz projekt</option>{% endif %}
                    {% for project in shell.projects %}
                        <option value="{{ project.id }}"{{ project.id == projectId ? ' selected' }}>{{ project.name }}</option>
                    {% endfor %}
                </select>
                <noscript><button type="submit">Przejdź</button></noscript>
            </form>
        {% endif %}

        {% if projectId %}
            <nav aria-label="Projekt">
                {% if is_granted('log.view') %}
                    <a href="{{ path('log_live', {projectId: projectId}) }}"{{ route == 'log_live' ? ' aria-current="page"' }}>{{ ui.icon('live') }} Live tail</a>
                    <a href="{{ path('log_events', {projectId: projectId}) }}"{{ route == 'log_events' ? ' aria-current="page"' }}>{{ ui.icon('events') }} Zdarzenia</a>
                {% endif %}
                {% if is_granted('source.manage') %}
                    <a href="{{ path('source_list', {projectId: projectId}) }}"{{ route starts with 'source_' ? ' aria-current="page"' }}>{{ ui.icon('sources') }} Źródła</a>
                {% endif %}
            </nav>
        {% endif %}

        <nav class="nav-secondary" aria-label="Aplikacja">
            <a href="{{ path('project_list') }}"{{ route == 'project_list' ? ' aria-current="page"' }}>{{ ui.icon('projects') }} Projekty</a>
            <a href="{{ path('debug') }}"{{ route == 'debug' ? ' aria-current="page"' }}>{{ ui.icon('debug') }} Debug</a>
        </nav>
    </aside>

    <div class="shell-main">
        <header class="topbar glass">
            {% set email = app.user.userIdentifier %}
            {% set role = is_granted('ROLE_SUPER_ADMIN') ? 'Super admin' : 'Użytkownik' %}
            <span class="avatar" title="{{ email }} ({{ role }})">
                <span aria-hidden="true">{{ email|first|upper }}</span>
                <span class="visually-hidden">Zalogowano jako {{ email }}, {{ role }}</span>
            </span>
            <form action="{{ path('identity_logout') }}" method="post" data-turbo="false">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
                <button type="submit" class="ghost">Wyloguj</button>
            </form>
        </header>
        <main>
            {% for type in ['error', 'success'] %}
                {% for flash in app.flashes(type) %}
                    <p class="{{ type == 'error' ? 'alert' : 'notice' }}" role="{{ type == 'error' ? 'alert' : 'status' }}">
                        {{ flash is iterable ? flash.key|trans(flash.parameters, 'domain') : flash }}
                    </p>
                {% endfor %}
            {% endfor %}
            {% block content %}{% endblock %}
        </main>
    </div>
</div>
{% endblock %}
