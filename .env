# Defaults only. Real secrets go to .env.local (git-ignored), real env vars or `bin/console secrets:set`.
# https://symfony.com/doc/current/configuration/secrets.html

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=http://localhost:8000
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
DATABASE_URL="postgresql://app:!ChangeMe!@127.0.0.1:5432/app?serverVersion=17&charset=utf8"
###< doctrine/doctrine-bundle ###

REDIS_URL=redis://127.0.0.1:6379

###> symfony/messenger ###
MESSENGER_TRANSPORT_DSN=redis://127.0.0.1:6379/messages
###< symfony/messenger ###

# Days of logs to keep (at least 8: ingestion accepts lines up to 7 days old).
LOG_RETENTION_DAYS=14
